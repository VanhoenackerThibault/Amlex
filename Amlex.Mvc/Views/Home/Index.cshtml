@using Amlex.Models.Models.LegalActs
@using Amlex.Models.Core
@using System.Linq

@{
    ViewData["Title"] = "Overview";

    List<LegalAct> legalActs = ViewBag.Acts as List<LegalAct> ?? new List<LegalAct>();

    List<EuroVocCodes> euroVocCodes = ViewBag.EuroVocCodes as List<EuroVocCodes>
        ?? new List<EuroVocCodes>();

    int inForceCount = legalActs.Count(x => x.InForce == true);
    int recentlyModifiedCount = legalActs.Count(x => x.LastModifiedAt >= DateTime.UtcNow.AddDays(-30));
    int upcomingDeadlines = legalActs.Count(x => x.Deadline.HasValue && x.Deadline.Value >= DateTime.UtcNow);
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="amx-page">

    @* ============================================================
       HERO — split: editorial headline left / CELLAR feed right
       ============================================================ *@
    <header class="amx-hero">
        <div class="amx-hero-layout">

            @* Left column *@
            <div class="amx-hero-content">
                <span class="amx-hero-label">EU food &amp; feed legal monitoring</span>

                <h1 class="amx-hero-title">
                    <span class="amx-hero-title-thin">Clarity across</span>
                    <span class="amx-hero-title-bold">European food legislation.</span>
                </h1>

                <p class="amx-hero-lede">
                    Track EU legal acts, amendments, and compliance deadlines in one
                    structured workspace — updated directly from CELLAR.
                </p>

                <div class="amx-hero-actions">
                    <a class="amx-btn-primary" href="#legal-acts">Explore legal acts</a>
                    <a class="amx-btn-ghost" href="#metrics">Monitoring summary</a>
                </div>
            </div>

            @* Right column — live CELLAR feed card *@
            @* <div class="amx-feed-card" aria-hidden="true">
                <div class="amx-feed-head">
                    <div>
                        <p class="amx-feed-head-label">CELLAR feed</p>
                        <p class="amx-feed-head-title">Recent activity</p>
                    </div>
                    <div class="amx-feed-pulse">
                        <span class="amx-feed-pulse-dot"></span>
                        live
                    </div>
                </div>

                <div class="amx-feed-body">
                    @if (legalActs.Any())
                    {
                        @foreach (var act in legalActs.Take(5))
                        {
                            <div class="amx-feed-row">
                                <span class="amx-feed-dot @(act.InForce == true ? "is-active" : "")"></span>
                                <div class="amx-feed-info">
                                    <span class="amx-feed-celex">@act.Celex</span>
                                    <span class="amx-feed-date">@act.LastModifiedAt.ToString("dd MMM yyyy")</span>
                                </div>
                                @if (act.InForce == true)
                                {
                                    <span class="amx-feed-pill">in force</span>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="amx-feed-empty">
                            No acts imported yet — run a CELLAR sync.
                        </div>
                    }
                </div>
            </div> *@

        </div>
    </header>

    @* ============================================================
       STATS BAR
       ============================================================ *@
    @* <div id="metrics" class="amx-stats-wrap">
        <div class="amx-stats-bar">
            <div class="amx-stat">
                <strong class="amx-stat-value">@legalActs.Count</strong>
                <span class="amx-stat-label">total acts</span>
            </div>
            <div class="amx-stat">
                <strong class="amx-stat-value">@inForceCount</strong>
                <span class="amx-stat-label">currently in force</span>
            </div>
            <div class="amx-stat">
                <strong class="amx-stat-value">@recentlyModifiedCount</strong>
                <span class="amx-stat-label">modified in 30 days</span>
            </div>
            <div class="amx-stat">
                <strong class="amx-stat-value">@upcomingDeadlines</strong>
                <span class="amx-stat-label">upcoming deadlines</span>
            </div>
        </div>
    </div> *@

    @* ============================================================
       LEGAL ACTS TABLE
       ============================================================ *@
    <main id="legal-acts" class="amx-section">

        <div class="amx-section-head">
            <div>
                <h2>Latest legal acts</h2>
                <p class="amx-section-desc">
                    Browse and filter EU food and feed legislation sourced from CELLAR.
                </p>
            </div>

            @if (legalActs.Any())
            {
                <div class="amx-controls">
                    <div class="amx-search">
                        <svg class="amx-search-icon" width="15" height="15" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="8" />
                            <line x1="21" y1="21" x2="16.65" y2="16.65" />
                        </svg>
                        <input type="search"
                               id="amx-search-input"
                               class="amx-search-input"
                               placeholder="Search CELEX, title…"
                               aria-label="Search legal acts" />
                    </div>

                    <div class="amx-filter-group" role="group" aria-label="Filter by status">
                        <button type="button" class="amx-filter is-active" data-filter="all">All</button>
                        <button type="button" class="amx-filter" data-filter="in-force">In force</button>
                        <button type="button" class="amx-filter" data-filter="not-in-force">Not in force</button>
                    </div>
                </div>
            }
        </div>

        @if (!legalActs.Any())
        {
            <div class="amx-empty">
                <div class="amx-empty-icon" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.6"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="9" y1="13" x2="15" y2="13" />
                        <line x1="9" y1="17" x2="13" y2="17" />
                    </svg>
                </div>
                <h3>No legal acts imported yet</h3>
                <p>Run a CELLAR synchronisation to populate Amlex with European food and feed legislation.</p>
            </div>
        }
        else
        {
            <div class="amx-table-card">
                <div class="amx-table-scroll">
                    <table class="amx-table" id="amx-acts-table">
                        <thead>
                            <tr>
                                <th>CELEX</th>
                                <th>Title</th>
                                <th>Status</th>
                                <th>Dates</th>
                                <th>Modified</th>
                                <th class="amx-align-right">Source</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var act in legalActs)
                            {
                                var statusKey = act.InForce == true ? "in-force"
                                              : act.InForce == false ? "not-in-force"
                                                                     : "unknown";

                                var primaryTitle = act.TitleNl ?? act.TitleEn ?? act.TitleFr ?? "Untitled legal act";

                                <tr data-status="@statusKey"
                                    data-search="@act.Celex @primaryTitle @act.TitleEn @act.TitleFr">

                                    @* CELEX *@
                                    <td>
                                        <span class="amx-celex">
                                            <a href="@($"https://eur-lex.europa.eu/legal-content/NL/TXT/PDF/?uri=CELEX:{act.Celex}")"
                                               target="_blank" rel="noopener">@act.Celex</a>
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(act.ResourceType))
                                        {
                                            <span class="amx-resource-type">@act.ResourceType</span>
                                        }
                                    </td>

                                    @* Title + tags *@
                                    <td>
                                        <a class="text-decoration-none" asp-action="LegalActDetails" asp-route-id="@act.Id"> 

                                            <div class="amx-act-title">@primaryTitle</div>
                                        </a>

                                        @{
                                            bool hasTags = (act.Relations?.Any() == true) ||
                                                           (act.Topics?.Any() == true);
                                        }
                                        @if (hasTags)
                                        {
                                            <div class="amx-tags">
                                                @if (act.Relations?.Any() == true)
                                                {
                                                    <span class="amx-tag">
                                                        @act.Relations.Count
                                                        @(act.Relations.Count == 1 ? "relation" : "relations")
                                                    </span>
                                                }
                                                @foreach (var topic in (act.Topics ?? Enumerable.Empty<Amlex.Models.Core.LegalActTopic>()))
                                                {
                                                    var euroVocSection = euroVocCodes
                                                        .FirstOrDefault(code => string.Equals(code.EuroVocUri,topic.EuroVocUri))?.SectionName;
                                                    if (euroVocSection is not null)
                                                    {
                                                        <span class="amx-tag">
                                                            @(euroVocSection)
                                                        </span>
                                                    }
                                                }
                                            </div>
                                        }
                                    </td>

                                    @* Status *@
                                    <td>
                                        @if (act.InForce == true)
                                        {
                                            <span class="amx-status amx-status-active">In force</span>
                                        }
                                        else if (act.InForce == false)
                                        {
                                            <span class="amx-status amx-status-inactive">Not in force</span>
                                        }
                                        else
                                        {
                                            <span class="amx-status amx-status-unknown">Unknown</span>
                                        }
                                    </td>

                                    @* Dates *@
                                    <td>
                                        <span class="amx-date-primary">
                                            @(act.DocumentDate?.ToString("dd MMM yyyy") ?? "—")
                                        </span>
                                        @if (act.Deadline.HasValue)
                                        {
                                            <span class="amx-date-secondary">
                                                Due @act.Deadline.Value.ToString("dd MMM yyyy")
                                            </span>
                                        }
                                    </td>

                                    @* Modified *@
                                    <td>
                                        <span class="amx-modified">
                                            @act.LastModifiedAt.ToString("dd MMM yyyy")
                                        </span>
                                    </td>

                                    @* Source link *@
                                    <td class="amx-align-right">
                                        <a class="amx-cellar-link"
                                           href="@act.CellarId"
                                           target="_blank"
                                           rel="noopener">
                                            CELLAR
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div id="amx-no-results" class="amx-no-results" hidden>
                    No legal acts match your current filters.
                </div>
            </div>
        }

    </main>
</div>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}