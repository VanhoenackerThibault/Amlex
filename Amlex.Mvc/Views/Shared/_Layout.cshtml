<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] — Amlex</title>

    @* Google Fonts: DM Sans  *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;1,9..40,400&display=swap" rel="stylesheet" />

    @* Keep Bootstrap CSS — needed for form-control / validation scaffolding  *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    @* Amlex global styles (overrides Bootstrap visually)  *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Amlex.Mvc.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @* ========================================================  *@
    @*  HEADER                                                    *@
    @* ========================================================  *@
    <header class="amx-header">
        <div class="amx-header-inner">

            @* Logo  *@
            <a class="amx-logo" asp-area="" asp-controller="Home" asp-action="Index">
                am<span class="amx-logo-lex">lex</span>
            </a>

            @* Primary nav  *@
            <nav class="amx-nav" aria-label="Main">
                <ul class="amx-nav-list">
                    <li>
                        <a asp-area="" asp-controller="Home" asp-action="Index">legal acts</a>
                    </li>
                    <li>
                        <a asp-area="" asp-controller="Home" asp-action="Privacy">privacy</a>
                    </li>
                </ul>
            </nav>

            @* Auth cluster  *@
            <div class="amx-header-auth">
                @if (User.Identity is not null && User.Identity.IsAuthenticated)
                {
                    <span class="amx-header-user" title="@User.Identity.Name">
                        @User.Identity.Name
                    </span>

                    <form asp-controller="Authentication" asp-action="SignOut" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="amx-signout-btn">
                            Sign out
                        </button>
                    </form>
                }
                else
                {
                    <a class="amx-link-register"
                       asp-area="" asp-controller="Authentication" asp-action="Register">
                        register
                    </a>
                    <a class="amx-btn-signin"
                       asp-area="" asp-controller="Authentication" asp-action="SignIn">
                        sign in
                    </a>
                }
            </div>

            @* Mobile toggle  *@
            <button class="amx-mobile-toggle"
                    id="amx-mobile-toggle"
                    aria-label="Open navigation"
                    aria-expanded="false"
                    aria-controls="amx-mobile-nav">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>

        @* Mobile drawer  *@
        <div class="amx-mobile-nav" id="amx-mobile-nav" role="navigation" aria-label="Mobile">
            <a asp-area="" asp-controller="Home" asp-action="Index">legal acts</a>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">privacy</a>

            @if (User.Identity is not null && User.Identity.IsAuthenticated)
            {
                <span style="padding:10px 14px;font-size:.8125rem;color:var(--ash);">
                    @User.Identity.Name
                </span>
                <form asp-controller="Authentication" asp-action="SignOut" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" style="margin-left:0;">Sign out</button>
                </form>
            }
            else
            {
                <a asp-area="" asp-controller="Authentication" asp-action="Register">register</a>
                <a class="amx-mobile-cta"
                   asp-area="" asp-controller="Authentication" asp-action="SignIn">
                    sign in
                </a>
            }
        </div>
    </header>

    @* ========================================================  *@
    @*  BODY                                                      *@
    @* ========================================================  *@
    @RenderBody()

    @* ========================================================  *@
    @*  FOOTER                                                    *@
    @* ========================================================  *@
    <footer class="amx-footer">
        <div class="amx-footer-inner">
            <a class="amx-footer-logo"
               asp-area="" asp-controller="Home" asp-action="Index">
                am<span>lex</span>
            </a>

            <nav class="amx-footer-links" aria-label="Footer">
                <a asp-area="" asp-controller="Home" asp-action="Privacy">privacy</a>
            </nav>

            <p class="amx-footer-copy">&copy; 2026 Amlex</p>
        </div>
    </footer>

    @* Scripts  *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>