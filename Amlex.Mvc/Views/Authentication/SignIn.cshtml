@model SignInRequest

@{
    ViewData["Title"] = "Sign in";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="amx-auth-page">

    @* Brand panel *@
    <div class="amx-auth-brand">
        <div class="amx-auth-brand-top">
            <a class="amx-auth-brand-logo"
               asp-area="" asp-controller="Home" asp-action="Index">
                am<span>lex</span>
            </a>

            <div class="amx-auth-brand-headline">
                <h2>Stay ahead of EU food legislation.</h2>
                <p>
                    Monitor legal acts, track amendments, and manage compliance
                    deadlines — all in one place.
                </p>
            </div>

            <ul class="amx-auth-features">
                <li>Automated CELLAR synchronisation</li>
                <li>Real-time in-force status tracking</li>
                <li>Search across CELEX, title, and topics</li>
                <li>Deadline and amendment alerts</li>
            </ul>
        </div>

        <p class="amx-auth-brand-footer">&copy; 2026 Amlex</p>
    </div>

    @* Form panel *@
    <div class="amx-auth-form-panel">
        <div class="amx-auth-card">
            <div class="amx-auth-head">
                <h1>Sign in</h1>
                <p>Access your EU food and feed legal monitoring workspace.</p>
            </div>

            <div asp-validation-summary="ModelOnly" role="alert"></div>

            <form method="post"
                  asp-controller="Authentication"
                  asp-action="SignInRequest">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="username"
                           placeholder="name@company.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password"
                           class="form-control"
                           autocomplete="current-password"
                           placeholder="Enter your password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Sign in</button>
            </form>

            <p class="amx-auth-footer-link mt-3">
                No account yet?
                <a asp-controller="Authentication" asp-action="Register">Create one</a>
            </p>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}